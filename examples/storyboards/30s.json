        "text": "真正降低视频生产门槛的，不是某一个模型，而是一条稳定流水线。",
        "delivery": {
          "tone": "confident",
          "pace": "medium",
          "emotion": "assured",
          "pause_after_sec": 0.2
        },
        "keywords": ["视频生产", "稳定流水线"]
      },
      "voice": {
        "asset_ref": "voice_primary",
        "style": "clear_enterprise",
        "target_lufs": -16
      },
      "avatar": {
        "asset_ref": "avatar_primary",
        "framing": "medium_close",
        "head_motion": "natural_low",
        "gesture_intensity": "low",
        "eye_contact": "camera",
        "background_mode": "template"
      },
      "layout": {
        "type": "avatar_left_keywords_right",
        "template_ref": "template_default"
      },
      "subtitles": {
        "mode": "word_aligned",
        "style": "bold_keyword",
        "max_lines": 2,
        "safe_area": "lower_third",
        "burn_in": true
      },
      "visuals": {
        "background": "brand_gradient_soft",
        "emphasis": [
          {
            "type": "keyword_highlight",
            "text": "稳定流水线",
            "timing": "on_word"
          }
        ],
        "safe_areas": {
          "subtitle_bottom_pct": 18,
          "face_protection": true
