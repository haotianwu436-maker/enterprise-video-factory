      "visuals": { "background": "brand_gradient_soft", "emphasis": [{ "type": "quote_pop", "text": "局部重试和自动修复", "timing": "scene_mid" }], "safe_areas": { "subtitle_bottom_pct": 18, "face_protection": true } },
      "music": { "asset_ref": "music_bed", "ducking": true, "target_lufs": -20, "fade_in_sec": 0, "fade_out_sec": 0 },
