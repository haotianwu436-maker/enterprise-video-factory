      "visuals": { "background": "brand_gradient_soft", "emphasis": [{ "type": "keyword_highlight", "text": "可审计的生产记录", "timing": "scene_mid" }], "safe_areas": { "subtitle_bottom_pct": 18, "face_protection": true } },
      "music": { "asset_ref": "music_bed", "ducking": true, "target_lufs": -20, "fade_in_sec": 0, "fade_out_sec": 0.5 },
