      "music": { "asset_ref": "music_bed", "ducking": true, "target_lufs": -20, "fade_in_sec": 0, "fade_out_sec": 0 },
      "transitions": { "in": "cut", "out": "cut" },
      "qc_expectations": { "requires_face_visible": true, "requires_lip_sync": true, "requires_subtitle_safe_area": true, "manual_review_tags": [] }
