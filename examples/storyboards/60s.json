  "scenes": [
    {
      "scene_id": "scene_001",
      "order": 1,
      "duration_sec": 10,
      "script": {
        "text": "企业级自动口播视频，不是把几个模型串起来那么简单。",
        "delivery": {
          "tone": "confident",
          "pace": "medium",
          "emotion": "assured",
          "pause_after_sec": 0.2
        },
        "keywords": ["企业级", "自动口播视频"]
      },
      "voice": { "asset_ref": "voice_primary", "style": "clear_enterprise", "target_lufs": -16 },
      "avatar": { "asset_ref": "avatar_primary", "framing": "medium_close", "head_motion": "natural_low", "gesture_intensity": "low", "eye_contact": "camera", "background_mode": "template" },
      "layout": { "type": "avatar_center", "template_ref": "template_default" },
      "subtitles": { "mode": "word_aligned", "style": "bold_keyword", "max_lines": 2, "safe_area": "lower_third", "burn_in": true },
      "visuals": { "background": "brand_gradient_soft", "emphasis": [{ "type": "keyword_highlight", "text": "几个模型串起来", "timing": "scene_mid" }], "safe_areas": { "subtitle_bottom_pct": 18, "face_protection": true } },
      "music": { "asset_ref": "music_bed", "ducking": true, "target_lufs": -20, "fade_in_sec": 0.3, "fade_out_sec": 0 },
      "transitions": { "in": "fade", "out": "cut" },
      "qc_expectations": { "requires_face_visible": true, "requires_lip_sync": true, "requires_subtitle_safe_area": true, "manual_review_tags": [] }
    },
    {
